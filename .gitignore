# Python cache
__pycache__/
*.py[cod]
*.egg-info/
dist/

# Logs (retain .gitkeep, ignore everything else)
logs/*
!logs/.gitkeep

# Compiled native libraries
*.so
*.o
*.obj
*.dll
*.dylib
*.lib

# Animation output
animations/*.mp4
animations/*.gif
animations/*.png

# Benchmark output
benchmark_results.csv
benchmark_shaped.csv

# Profile output
*.txt

# OS junk
.DS_Store
Thumbs.db
